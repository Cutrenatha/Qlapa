# Qlapa Backend - Railway Environment Variables
# Copy semua ini ke Railway → Settings → Variables

DATABASE_URL=postgresql://...  # Otomatis dari Railway PostgreSQL plugin
JWT_SECRET_KEY=

MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

GOOGLE_API_KEY=
GEMINI_API_KEY=

# Optional: jalankan Qlapa AI sebagai service FastAPI terpisah.
# Backend utama akan fallback ke AI lokal kalau service ini mati/timeout.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT=6
AI_SERVICE_ENABLED=true
